# ==============================================================================
# JanSetu AI - AWS Hackathon Environment Configuration
# Add your real AWS credentials below (obtained from AWS Console > IAM > Security Credentials)
# ==============================================================================

# 1. AWS Cloud Region (recommend us-east-1)
# Note: For AWS Amplify hosting, use APP_AWS_REGION to bypass Amplify's reserved "AWS_" prefix check.
AWS_REGION=us-east-1
APP_AWS_REGION=us-east-1

# 2. IAM User Credentials (Access Key & Secret Key)
# Note: For AWS Amplify hosting, use APP_AWS_ACCESS_KEY_ID & APP_AWS_SECRET_ACCESS_KEY
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=

# Optional: Session Token (only required if using temporary student/Learner Lab credentials)
# AWS_SESSION_TOKEN=
# APP_AWS_SESSION_TOKEN=

# 3. Amazon Bedrock Configuration
# Amazon Nova Lite is AWS's first-party multimodal model - zero forms or approvals required!
# Alternatives: amazon.nova-pro-v1:0, amazon.titan-text-express-v1, meta.llama3-8b-instruct-v1:0
# Note: In AWS Amplify console, use BEDROCK_MODEL_ID
AWS_BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# 3.5. Instant Free Multi-Provider AI Keys (Zero-Wait Live AI Streaming)
# Option A: Groq Cloud (Free Llama 3.3 70B @ ~500 tok/s): https://console.groq.com/keys
GROQ_API_KEY=
# Option B: Google Gemini (Free Gemini 2.0 Flash + Multimodal Vision): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 4. Amazon DynamoDB Tables (Created automatically via `node scripts/seed-dynamodb.mjs`)
DYNAMODB_SCHEMES_TABLE=JanSetuSchemes
DYNAMODB_DOSSIERS_TABLE=JanSetuDossiers

# 5. Amazon S3 Bucket for Document Dossiers & Notarized Affidavits
S3_BUCKET_NAME=jansetu-citizen-dossiers

# 6. LocalStack / Offline Emulation (Optional - leave blank when using real AWS Cloud)
# AWS_ENDPOINT_URL=http://localhost:4566
